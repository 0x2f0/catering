{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "catering-backend",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-15",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"d1_databases": [
		{
			"binding": "catering_backend_db",
			"database_name": "catering-backend-db",
			"database_id": "04207566-d046-4ecb-9a14-31f2fe541a6b"
		}
	]
}
